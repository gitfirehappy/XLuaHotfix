<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- 发布与累计逻辑都写在 UNITY_EDITOR 条件块内（Editor 侧代码），场景按同一定义链接。 -->
    <DefineConstants>UNITY_EDITOR</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="scenario_support.cs" />
    <Compile Include="test_file_diff.cs" />
    <Compile Include="test_publish_containment.cs" />
    <Compile Include="test_publish_identity_source.cs" />
    <Compile Include="stubs/*.cs" />
    <!-- 生产源码：无状态 Diff、累计计划与发布事务均为纯逻辑，只依赖 System 与 FileHelper -->
    <Compile Include="../../../Assets/FYAsset/Scripts/Shared/Build/Publish/IPackageManifestReader.cs" Link="Production/IPackageManifestReader.cs" />
    <Compile Include="../../../Assets/FYAsset/Scripts/Shared/Build/Publish/PackageBuildIdentity.cs" Link="Production/PackageBuildIdentity.cs" />
    <Compile Include="../../../Assets/FYAsset/Scripts/Shared/Build/Publish/PublishPathGuard.cs" Link="Production/PublishPathGuard.cs" />
    <Compile Include="../../../Assets/FYAsset/Scripts/Shared/Build/Publish/PublishRequest.cs" Link="Production/PublishRequest.cs" />
    <Compile Include="../../../Assets/FYAsset/Scripts/Shared/Build/Publish/PackageFileScanner.cs" Link="Production/PackageFileScanner.cs" />

    <Compile Include="../../../Assets/FYAsset/Scripts/Shared/Build/Publish/IFullPackageBaselineSource.cs" Link="Production/IFullPackageBaselineSource.cs" />
    <Compile Include="../../../Assets/FYAsset/Scripts/AB/Hotfix/ABHotfixTargetResolver.cs" Link="Production/ABHotfixTargetResolver.cs" />
    <Compile Include="../../../Assets/FYAsset/Scripts/Shared/Build/Publish/PublishTargetConfig.cs" Link="Production/PublishTargetConfig.cs" />
    <Compile Include="../../../Assets/FYAsset/Scripts/Shared/Build/Publish/PublishTargetContracts.cs" Link="Production/PublishTargetContracts.cs" />
    <Compile Include="../../../Assets/FYAsset/Scripts/Shared/Build/Publish/PackagePublisher.cs" Link="Production/PackagePublisher.cs" />    <Compile Include="../../../Assets/FYAsset/Scripts/Shared/Build/Publish/PackageRemoteReader.cs" Link="Production/PackageRemoteReader.cs" />
    <Compile Include="../../../Assets/FYAsset/Scripts/Shared/Build/Publish/PackageContentResolver.cs" Link="Production/PackageContentResolver.cs" />
    <Compile Include="../../../Assets/FYAsset/Scripts/Shared/Build/Publish/PackageUploader.cs" Link="Production/PackageUploader.cs" />
    <Compile Include="../../../Assets/FYAsset/Scripts/Shared/Build/Publish/PackageRetentionCleaner.cs" Link="Production/PackageRetentionCleaner.cs" />
    <Compile Include="../../../Assets/FYAsset/Scripts/Shared/Build/Versioning/VersionNumber.cs" Link="Production/VersionNumber.cs" />
    <Compile Include="../../../Assets/FYAsset/Scripts/Shared/Runtime/PackageIndex.cs" Link="Production/PackageIndex.cs" />
    <!-- Cloudflare 发布目标与 Wrangler 调用接缝：进程边界由测试替身驱动，不访问网络 -->
    <Compile Include="../../../Assets/FYAsset/Scripts/Compat/Editor/Publish/WranglerCommandRunner.cs" Link="Production/WranglerCommandRunner.cs" />
    <Compile Include="../../../Assets/FYAsset/Scripts/Shared/Helpers/FYAssetPathUtility.cs" Link="Production/FYAssetPathUtility.cs" />

    <Compile Include="../../../Assets/Tools/Scripts/FileHelper.cs" Link="Production/FileHelper.cs" />
    <Compile Include="../../../Assets/Tools/Scripts/HashGenerator.cs" Link="Production/HashGenerator.cs" />
    <Compile Include="../../../Assets/Tools/Scripts/Serialization/BinarySerializableAttribute.cs" Link="Production/BinarySerializableAttribute.cs" />
  </ItemGroup>
</Project>
