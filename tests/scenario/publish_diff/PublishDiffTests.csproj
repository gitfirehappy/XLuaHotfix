<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- 发布与累计逻辑都写在 UNITY_EDITOR 条件块内（Editor 侧代码），场景按同一定义链接。 -->
    <DefineConstants>UNITY_EDITOR</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="scenario_support.cs" />
    <Compile Include="test_file_diff.cs" />
    <Compile Include="test_publish_transaction.cs" />
    <Compile Include="test_publish_assembly.cs" />
    <Compile Include="test_cloudflare_rollback.cs" />
    <Compile Include="test_publish_containment.cs" />
    <Compile Include="test_publish_identity_source.cs" />
    <Compile Include="test_publish_maintenance.cs" />
    <Compile Include="stubs/*.cs" />
    <!-- 生产源码：无状态 Diff、累计计划与发布事务均为纯逻辑，只依赖 System 与 FileHelper -->
    <Compile Include="../../../Assets/FYAsset/Scripts/Shared/Build/FileDigest.cs" Link="Production/FileDigest.cs" />
    <Compile Include="../../../Assets/FYAsset/Scripts/Shared/Build/FileDiff.cs" Link="Production/FileDiff.cs" />
    <Compile Include="../../../Assets/FYAsset/Scripts/Shared/Build/Publish/PackageFileNames.cs" Link="Production/PackageFileNames.cs" />
    <Compile Include="../../../Assets/FYAsset/Scripts/Shared/Build/Publish/IPackageManifestReader.cs" Link="Production/IPackageManifestReader.cs" />
    <Compile Include="../../../Assets/FYAsset/Scripts/Shared/Build/Publish/PackageBuildIdentity.cs" Link="Production/PackageBuildIdentity.cs" />
    <Compile Include="../../../Assets/FYAsset/Scripts/Shared/Build/Publish/PublishPathGuard.cs" Link="Production/PublishPathGuard.cs" />
    <Compile Include="../../../Assets/FYAsset/Scripts/Shared/Build/Publish/PublishRequest.cs" Link="Production/PublishRequest.cs" />
    <Compile Include="../../../Assets/FYAsset/Scripts/Shared/Build/Publish/PublishCache.cs" Link="Production/PublishCache.cs" />
    <Compile Include="../../../Assets/FYAsset/Scripts/Shared/Build/Publish/PublishCacheStore.cs" Link="Production/PublishCacheStore.cs" />
    <Compile Include="../../../Assets/FYAsset/Scripts/Shared/Build/Publish/PackageFileScanner.cs" Link="Production/PackageFileScanner.cs" />
    <Compile Include="../../../Assets/FYAsset/Scripts/Shared/Build/Publish/IFullPackageBaselineSource.cs" Link="Production/IFullPackageBaselineSource.cs" />
    <Compile Include="../../../Assets/FYAsset/Scripts/Shared/Build/Publish/PackageTargetAssembler.cs" Link="Production/PackageTargetAssembler.cs" />
    <Compile Include="../../../Assets/FYAsset/Scripts/Shared/Build/Publish/PushTargetConfig.cs" Link="Production/PushTargetConfig.cs" />
    <Compile Include="../../../Assets/FYAsset/Scripts/Shared/Build/Publish/LocalDirectoryPushTarget.cs" Link="Production/LocalDirectoryPushTarget.cs" />
    <Compile Include="../../../Assets/FYAsset/Scripts/Shared/Build/Publish/PublishPlan.cs" Link="Production/PublishPlan.cs" />
    <Compile Include="../../../Assets/FYAsset/Scripts/Shared/Build/Publish/PackagePublishTransaction.cs" Link="Production/PackagePublishTransaction.cs" />
    <Compile Include="../../../Assets/FYAsset/Scripts/Shared/Build/Publish/BuildPublisher.cs" Link="Production/BuildPublisher.cs" />
    <Compile Include="../../../Assets/FYAsset/Scripts/Shared/Build/Publish/PublishMaintenance.cs" Link="Production/PublishMaintenance.cs" />
    <Compile Include="../../../Assets/FYAsset/Scripts/Shared/Build/Publish/PushModels.cs" Link="Production/PushModels.cs" />
    <Compile Include="../../../Assets/FYAsset/Scripts/Shared/Build/Versioning/VersionNumber.cs" Link="Production/VersionNumber.cs" />
    <Compile Include="../../../Assets/FYAsset/Scripts/Shared/Runtime/Manifests/PackageIndex.cs" Link="Production/PackageIndex.cs" />
    <!-- Cloudflare 发布目标与 Wrangler 调用接缝：进程边界由测试替身驱动，不访问网络 -->
    <Compile Include="../../../Assets/FYAsset/Scripts/Compat/Editor/Publish/WranglerCommandRunner.cs" Link="Production/WranglerCommandRunner.cs" />
    <Compile Include="../../../Assets/FYAsset/Scripts/Compat/Editor/Publish/CloudflarePagesPushTarget.cs" Link="Production/CloudflarePagesPushTarget.cs" />
    <Compile Include="../../../Assets/FYAsset/Scripts/Shared/Helpers/FYAssetPathUtility.cs" Link="Production/FYAssetPathUtility.cs" />
    <Compile Include="../../../Assets/Tools/Scripts/FileHelper.cs" Link="Production/FileHelper.cs" />
    <Compile Include="../../../Assets/Tools/Scripts/HashGenerator.cs" Link="Production/HashGenerator.cs" />
    <Compile Include="../../../Assets/Tools/Scripts/Serialization/BinarySerializableAttribute.cs" Link="Production/BinarySerializableAttribute.cs" />
  </ItemGroup>
</Project>
